# Variables marked [required] are validated at build time (src/config/env.ts).
# The app will refuse to start if any are missing.
# Variables marked [optional] have safe defaults or degrade gracefully when absent.

# ─── Meta / Facebook ──────────────────────────────────────────────────────────
META_APP_ID=                    # [required] Facebook App ID (from developers.facebook.com)
META_APP_SECRET=                # [required] Facebook App Secret — never client-side
META_SYSTEM_ACCESS_TOKEN=       # [required] Long-lived system user token for cron + Slack bot — never client-side
META_AD_ACCOUNT_ID=             # [optional] Primary ad account (format: act_XXXXXXXXX or raw numeric ID)
META_AD_ACCOUNT_IDS=            # [optional] Multi-account cron mode: comma-separated IDs (e.g. act_111,act_222)
NEXT_PUBLIC_FACEBOOK_PAGE_ID=   # [optional] Facebook Page ID used when creating ad creatives

# ─── Slack ────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=                # [required] xoxb-... bot token (OAuth scopes: chat:write, channels:read)
SLACK_SIGNING_SECRET=           # [required] Used for HMAC request signature verification on all inbound webhooks
SLACK_CLIENT_ID=                # [optional] Slack app client ID (for OAuth flow)
SLACK_CLIENT_SECRET=            # [optional] Slack app client secret (for OAuth flow) — never client-side
SLACK_NOTIFICATION_CHANNEL=     # [optional] Default channel for launch/budget alerts (e.g. C0XXXXXXXXX or #alerts)
SLACK_BUDGET_SUMMARY_CHANNEL=   # [optional] Channel for grouped end-of-run budget change summaries from automations
                                #            If unset, grouped summaries are skipped (per-entity notifications still fire)
SLACK_DIGEST_CHANNEL_IDS=       # [optional] Comma-separated channel IDs for periodic ad performance digest (GET /api/slack/digest)
                                #            Required for the weekly/daily/monthly digest cron to function
SLACK_GROWTH_CHANNEL=           # [optional] Channel for the daily acquisition-update TL;DR
                                #            (GET /api/cron/acquisition-update). Defaults to #emily-space

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Shared by every cron that writes to a Google Sheet (GoogleSheetsService.fromEnv()), and
# also by the Ad Winners cron's Drive lookup below (GoogleDriveService.fromEnv()) — same key,
# different scope.
GOOGLE_SERVICE_ACCOUNT_JSON=     # [required*] Base64-encoded Google service-account key JSON
                                 #             (base64 -i key.json). The target sheet must be
                                 #             shared with the key's client_email as an Editor,
                                 #             and (for the Ad Winners CREATIVE_FILE column) the
                                 #             "Wonderly ads" Drive folder shared with the same
                                 #             client_email as at least a Viewer.
                                 #             *Required by any cron below that has a sheet ID set;
                                 #             those crons return 503 without a sheet ID configured.
MARKETING_SHEET_ID=              # [optional] Sheet ID (from its URL) for the Marketing Performance
                                  #            ("Growth") sheet — GET /api/cron/marketing-daily (hourly)
AD_WINNERS_SHEET_ID=              # [optional] Sheet ID (from its URL) for the wonderly_winners sheet —
                                   #            GET /api/cron/ad-winners (weekly). See CLAUDE.md's
                                   #            "Ad Winners Sheet" section for the tab/threshold model.
                                   #            Its CREATIVE_FILE column needs the "Wonderly ads" Drive
                                   #            folder shared with GOOGLE_SERVICE_ACCOUNT_JSON's
                                   #            client_email — the run still succeeds without it,
                                   #            just with that column blank on every row.

# ─── Notion ───────────────────────────────────────────────────────────────────
NOTION_TOKEN=                   # [optional] Internal integration token for publishing the daily acquisition
                                #            update. Unset = readout is computed and returned but not published.
                                #            The integration must be shared into the parent page in Notion.
NOTION_ACQUISITION_PARENT_PAGE_ID=  # [optional] Spec page the "Growth report" container lives under.
                                    #            Defaults to the "Cost per Succeeding Contractor" spec page.
                                    #            Dated readouts nest inside that container, not here.

# ─── Snowflake ────────────────────────────────────────────────────────────────
# The warehouse behind both the Growth Sheet funnel and CAMP's customer data. Required by
# SnowflakeService.fromEnv() — the marketing-daily and acquisition-update crons both fail
# without these.
SNOWFLAKE_ACCOUNT=              # [required] Account identifier
SNOWFLAKE_USERNAME=             # [required] Service user (a dedicated service account, not a
                                #            personal login — personal accounts get swept up in
                                #            MFA enforcement and password/role changes)
SNOWFLAKE_PRIVATE_KEY=          # [required*] Key-pair (JWT) auth, preferred. PKCS8 PEM contents
                                #            of the service user's private key. Not subject to
                                #            MFA. In Vercel, paste with literal \n escapes.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE= # [optional] Only if the private key above is passphrase-protected.
SNOWFLAKE_PASSWORD=             # [required*] Legacy fallback if SNOWFLAKE_PRIVATE_KEY is unset.
                                #            Breaks on any account with MFA enforced — avoid.
                                # *One of SNOWFLAKE_PRIVATE_KEY or SNOWFLAKE_PASSWORD is required.
SNOWFLAKE_WAREHOUSE=            # [optional] Defaults to the user's default warehouse
SNOWFLAKE_ROLE=                 # [optional] Must hold SELECT on AMPLITUDE.* (an inbound Amplitude
                                #            Snowflake share — grant via IMPORTED PRIVILEGES),
                                #            AIRBYTE.CSM_OPS.CRM_*/BOOKING_LINK_INVITEES, and
                                #            WONDERLY_DATA.DERIVED__CUSTOMER_FUNNEL.* (the CAMP tables)

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=              # [required] Anthropic API key for Claude chat and Slack bot analysis
ANTHROPIC_MODEL=                # [optional] Defaults to claude-sonnet-4-6

# ─── Storage ──────────────────────────────────────────────────────────────────
REDIS_URL=                      # [optional] Redis connection string (e.g. redis://localhost:6379 or Upstash URL)
                                #            If unset, automation rules fall back to cookie-only storage

# ─── Security ─────────────────────────────────────────────────────────────────
CRON_SECRET=                    # [optional] Bearer token required on GET /api/automations/evaluate
                                #            Must match the secret set in vercel.json cron configuration
                                #            If unset in production, the endpoint is disabled (returns 503)
MCP_TOKEN=                      # [optional] Static bearer for the Growth MCP (/api/mcp), for header-capable
                                #            clients (e.g. Claude Code). Claude Desktop/Cowork use OAuth instead
                                #            (/api/oauth/*), gated by the app login + Redis — needs NEXT_PUBLIC_APP_URL
                                #            and REDIS_URL set. The MCP always requires one or the other (never open).
ALLOWED_USER_IDS=               # [optional] Comma-separated Facebook user ID allowlist for login
                                #            If unset, any Facebook user can log in
ALLOWED_SLACK_USER_IDS=         # [optional] Comma-separated Slack user ID allowlist for bot action buttons and mentions
                                #            If unset, any workspace member can execute actions and query the bot
ALLOWED_SLACK_CHANNEL_IDS=      # [optional] Comma-separated Slack channel ID allowlist for bot mentions
                                #            If unset, the bot responds to @mentions in any channel it's in

# ─── Automation Engine ────────────────────────────────────────────────────────
AUTOMATION_MAX_ACTIONS_PER_RUN= # [optional] Max Meta actions (pause/activate/promote) per cron run — defaults to 20
                                #            Prevents a misconfigured rule from pausing all active ads in one run

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=            # [required] Canonical app URL used in OAuth redirect URIs (e.g. https://your-app.vercel.app)

# ─── Dev ──────────────────────────────────────────────────────────────────────
USE_MOCK_DATA=                  # [optional] Set to "true" to use mock ad data in development (no Meta API calls)
